# ==============================================================================
# SMART IOT POULTRY FARMING DASHBOARD - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env.local` and substitute your actual values.
# ==============================================================================

# Firebase Realtime Database & Project Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id

# Operator Portal Authentication
NEXT_PUBLIC_ADMIN_USERNAME=admin
NEXT_PUBLIC_ADMIN_PASSWORD=your_secure_password_here
